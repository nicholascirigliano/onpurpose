rules_version = '2';

// One collection: purposes/{id}. The id is a random Firestore id, and it's the
// secret in the link, so anyone holding a link can see that one purpose and
// purpose back. Nobody can browse other people's purposes.
service cloud.firestore {
  match /databases/{database}/documents {

    match /purposes/{purposeId} {

      function signedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function shortString(value, max) {
        return value is string && value.size() > 0 && value.size() <= max;
      }

      function validNewPurpose() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'senderName', 'recipientName', 'phrase',
                                 'replyWindowMinutes', 'createdAt', 'dueAt',
                                 'purposedBackAt', 'reply'])
          && d.ownerUid == request.auth.uid
          && shortString(d.senderName, 40)
          && shortString(d.recipientName, 40)
          && shortString(d.phrase, 80)
          && d.replyWindowMinutes is int
          && d.replyWindowMinutes > 0 && d.replyWindowMinutes <= 10080
          && d.createdAt == request.time
          && d.dueAt is timestamp && d.dueAt > request.time
          && d.purposedBackAt == null
          && d.reply == null;
      }

      // Purposing back: anyone with the link, once, touching only these two fields.
      function validPurposeBack() {
        let d = request.resource.data;
        return resource.data.purposedBackAt == null
          && d.diff(resource.data).affectedKeys().hasOnly(['purposedBackAt', 'reply'])
          && d.purposedBackAt == request.time
          && shortString(d.reply, 140);
      }

      allow get: if true;
      allow list: if isOwner();
      allow create: if signedIn() && validNewPurpose();
      allow update: if validPurposeBack();
      allow delete: if isOwner();
    }
  }
}
